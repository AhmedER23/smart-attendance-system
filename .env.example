# Bu dosyayı ".env" olarak kopyalayıp kullanın.
# Güvenlik nedeniyle .env dosyasını asla GitHub'a yüklemeyin (.gitignore'a eklenmiştir).

# Oturum çerezlerini imzalayan gizli anahtar. Üretmek için:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=degistiriniz_veya_secrets_ile_uretiniz

# Boş bırakırsanız instance/yoklama.db (SQLite) kullanılır.
# MySQL örneği: mysql+pymysql://kullanici:parola@localhost:3306/yoklama_db?charset=utf8mb4
DATABASE_URL=

# Yüz eşleştirme eşiği (kosinüs mesafesi). Facenet için önerilen standart değer 0.40'tır.
FACE_MATCH_THRESHOLD=0.40

# Açık öğretmen kaydı (kayıt sayfası)
ALLOW_TEACHER_REGISTRATION=true

# Sunucu ayarları (Yerel ağ ve telefon erişimi için 0.0.0.0 ve SSL önerilir)
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
USE_SSL=1

# Model ve ağırlık önbellek dizinleri (proje içi)
KERAS_HOME=.keras
DEEPFACE_HOME=.
